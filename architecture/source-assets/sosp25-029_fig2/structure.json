  "guide": {
    "title": "双边缘执行与中央状态协调",
    "summary": "两侧近用户执行区围绕中央存储协调区展开。边缘区内部含函数执行、运行时和缓存，中央区把请求处理、后续处理、状态表及备用动作分层放置。左右相似布局说明同类站点共享中央服务，底部表格让读者看到保存的信息，而非只有抽象数据库图标。",
    "suitable_for": [
      "多边缘站点共享中央状态",
      "需要解释初始请求与后续确认的协调协议"
    ],
    "not_suitable_for": [
      "纯无状态请求转发",
      "大量站点之间的任意网状通信"
    ],
    "reading_order": [
      "从一侧用户图标进入边缘执行区",
      "辨认运行时与缓存交互，再追踪跨站请求",
      "在中央区区分初始处理与后续处理",
      "向下看意图表、数据表和备用动作，最后用右侧验证多站点对称性"
    ],
    "design": {
      "layout": "横向三栏，中央较宽，两侧近似镜像；表格位于各站点下部，防止跨站线穿越字段。",
      "shapes": "圆角框逐层包含运行环境和功能，小表格显示键、值、版本等结构，人形标记服务使用者。",
      "connectors": "细黑箭头统一表达通信，方向和邻近文字区分请求与回访；时钟小图形提示超时触发路径。",
      "color": "主要采用黑白轮廓，没有用颜色区分协议消息，区分责任依赖分组标题和位置。",
      "typography": "衬线正文与斜体函数符号形成技术说明感；三栏内容密集，优先保持最终版面的可读字号。"
    },
    "adaptation": [
      "先明确谁拥有权威数据，谁保存缓存副本",
      "逐条标注初始请求、后续通知和超时补偿的真实含义",
      "保持左右站点数据字段一致，除非异构就是要解释的重点",
      "增加第三类站点或更多表字段时重排三栏比例，不直接压缩字体"
    ],
    "example": {
      "scenario": "可用于多门店库存预占系统的设计图。",
      "mapping": "边缘区对应门店收银与库存缓存，中央处理组对应预占申请及确认，状态表记录订单与预占状态。",
      "structural_changes": "根据真实协议增设取消或超时释放路径；将备用函数图标改为补偿动作，不宣称具备未经实现的一致性保证。"
    },
    "checks": [
      "本地缓存与中央权威数据是否区分明确",
      "后续处理的返回线有没有误接到初始入口",
      "超时图标和备用动作是否有真实触发条件"
    ],
