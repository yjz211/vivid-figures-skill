  "guide": {
    "asset_id": "architecture.source.nsdi23-004_fig1",
    "title": "通信处理前后对照与插件展开",
    "summary": "左右两幅系统结构配合底部调用链，比较分散处理与集中托管。左侧应用和旁路服务各自执行编码转换，右侧把处理集中到统一服务，并用局部展开显示策略和传输插件。底部小圆徽标把重复处理成本具象化。",
    "suitable_for": [
      "通信栈重构前后对照",
      "强调减少重复中间处理的设计"
    ],
    "not_suitable_for": [
      "两个方案接口不一致的公平性比较",
      "需要给出性能数值的实验结果图"
    ],
    "reading_order": [
      "阅读顶部转换操作图例。",
      "看左侧应用、旁路服务及底部多次转换链。",
      "看右侧应用进入统一处理服务。",
      "最后查看右边插件展开和简化后的调用链。"
    ],
    "design": {
      "layout": "竖虚线分成两方案，底部按相同高度放调用与返回链；右侧附插件放大栏。",
      "shapes": "叠层矩形表示协议栈，小圆 M/U 表示两类转换操作，中心连接形状表示内部服务转接。",
      "connectors": "上部实线是模块交互；下部水平双向路线分别表示调用与回复；细虚线引出插件细节。",
      "color": "应用绿色、旁路政策青色、统一服务与插件蓝色，黄色徽标用于转换动作。",
      "typography": "方案标题加粗并置底，插件名较短；代码或协议名不宜扩写成长句。"
    },
    "parts": [
      {
        "id": "legacy-service",
        "name": "分散处理结构",
        "meaning": "应用与旁路服务各有通信库。",
        "adaptation": "保留两次边界穿越仅当新对照确实如此。"
      },
      {
        "id": "managed-service",
        "name": "统一服务结构",
        "meaning": "应用把公共处理交给独立服务。",
        "adaptation": "重定义前端、传输和内部转接职责。"
      },
      {
        "id": "plugin-inset",
        "name": "插件展开",
        "meaning": "策略插件与传输实现分层。",
        "adaptation": "替换为实际可插拔模块，不混同必选依赖。"
      },
      {
        "id": "legacy-path",
        "name": "原调用链",
        "meaning": "展示多次编码和解码。",
        "adaptation": "按真实协议逐一核对徽标，不为突出改进夸大次数。"
      },
      {
        "id": "new-path",
        "name": "改造后调用链",
        "meaning": "展示经过集中处理的转换序列。",
        "adaptation": "接口与左图保持一致，才能比较路径差异。"
      }
    ],
    "adaptation": [
      "先固定两方案的同一请求和同一返回口径。",
      "图中少掉的转换步骤必须能由实现解释。",
      "插件层若不是可替换选项，应改成普通组成模块。"
    ],
    "example": {
      "scenario": "假设用于多服务数据格式转换优化。",
      "mapping": "左侧每个服务前置独立格式适配器，右侧使用共享转换网关，徽标表示序列化和反序列化。",
      "structural_changes": "将传输协议栈换成格式解析、校验和传输插件，并重画真实调用链。"
    },
    "checks": [
      "两方案的调用与回复起终点相同。",
      "每个转换徽标在上部结构中有对应位置。",
      "插件引线没有被误认为额外网络请求。"
    ],
    "editing": {
      "entry": "以 make_figure.py 为入口，先复制 example.json 作为当前情景配置；labels.json 定位标签，asset.json 定位部件。",
      "configurable": "labels 可改文字和文字样式，components 可做显隐、平移和局部样式调整；elements 可定位矢量元素。配置只作用于已有几何，不会自动解决布局冲突。",
      "code_required": "增减转换次数、替换插件层数或修改方案布局需改小徽标、箭头及边界；不能仅靠更名证明性能改进。",
      "fonts": "当前替换字体为 texgyreheros-bold、texgyreheros-bolditalic、texgyreheros-regular。改字后检查字宽、基线及 PDF 字体嵌入；原图的逐字定位不保证能容纳更长名称。"
    },
    "display_code": "VA-050"
