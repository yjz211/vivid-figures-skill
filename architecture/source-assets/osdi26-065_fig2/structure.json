  "guide": {
    "asset_id": "architecture.source.osdi26-065_fig2",
    "title": "多资源池需求汇聚与共同清算",
    "summary": "多个资源池以等宽竖列排列，每列内部有成组的需求方、预算信息和本池供给。横跨所有列的虚线清算带把局部供给和共享供给纳入共同决策，再向各列输出价格或分配结果。重复列说明并行参与，横带说明耦合关系。",
    "suitable_for": [
      "多群体竞争本地与共享资源",
      "输入按群体分开、决策需要统一协调"
    ],
    "not_suitable_for": [
      "各群体完全独立无共同约束",
      "无价格含义却直接保留报价术语的分配任务"
    ],
    "reading_order": [
      "先横向辨认三个资源池及省略的其他池。",
      "进入任一列，自上而下读取需求方、预算和申报。",
      "查看本池供给与申报如何进入横向清算区。",
      "读取共享供给条，再沿下行线查看分池输出。"
    ],
    "design": {
      "layout": "三列等宽竖向泳道，清算区横向穿透各列，下方输出保持逐列对齐。",
      "shapes": "叠片表示池内多个需求方，内部小框表示申报字段，长条表示跨池共享资源。",
      "connectors": "细有向线把需求、池供给、共同清算和输出串接；清算虚线只标协作范围。",
      "color": "淡黄表示资源池背景，浅蓝表示需求方和供给，粉色为工作负载，绿色为预算字段，灰色为报价，金黄突出结果。",
      "typography": "短字段分行置于窄列，清算标题加粗，输入输出同列对齐；池数增加时宜横向加宽。"
    },
    "parts": [
      {
        "id": "pool-one",
        "name": "第一资源池",
        "meaning": "包含需求、专属供给及本池结果。",
