    ],
    "adaptation": [
      "先确定本池供给与共享供给能否同时使用。",
      "定义报价、预算、价格的单位及彼此关系。",
      "增加资源池时扩展横带并重接逐池输出。"
    ],
    "example": {
      "scenario": "可用于区域公共算力分配。",
      "mapping": "每列映射为一个部门，需求方为项目组，预算为使用额度，横带为共享算力调度，底部输出为部门结算价格。",
      "structural_changes": "若模型只求配额不定价，应将报价与价格同时改为优先级和分配量，重写清算规则。"
    },
    "checks": [
      "各列专属供给是否与共享供给分开标示。",
      "清算输出是否仍与各资源池一一对齐。",
      "预算、报价与结果是否使用一致单位而非仅借用名词。"
    ],
    "editing": {
      "entry": "运行 make_figure.py；example.json 为配置，labels.json 查文字键，asset.json 查部件。使用 --parts 导出独立矢量部件。",
      "configurable": "labels 可改文字及字体；components 可设置 visible、dx/dy、attributes；elements 可按键改图元属性。移动量使用整图 viewBox 单位，重叠部件只选一个层级移动。",
      "code_required": "增删节点、调整连接和重排结构须在 customize() 中处理；新增图元使用唯一 data-asset-key，并登记至相应部件 element_keys。配置不会自动排版。",
      "fonts": "本图使用 Arimo-Bold.ttf、Arimo-Regular.ttf。font_size 是图元局部坐标单位，受既有缩放影响，不等于纸面 pt；改字后检查实际字宽与最终阅读尺寸。"
    },
