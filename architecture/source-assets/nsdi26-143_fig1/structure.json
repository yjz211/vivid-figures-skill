  "guide": {
    "asset_id": "architecture.source.nsdi26-143_fig1",
    "title": "全连接、中心交换与分组互连对照",
    "summary": "左边两个小面板展示全连接和中心交换，右边大面板展示若干局部组与上层共享节点。图通过相同节点形状把三种拓扑放在同一语法中，突出局部连接和跨组连接的层次差别。线条表示连接存在，不直接表示流量、带宽或性能。",
    "suitable_for": [
      "比较两类节点的不同连接组织",
      "需要解释局部密集与跨组稀疏的组合"
    ],
    "not_suitable_for": [
      "有向业务流程",
      "需要从图面距离读取物理距离的地理网络"
    ],
    "reading_order": [
      "左上先读两类节点的全连接。",
      "左下看加入中心交换节点后的拓扑。",
      "右侧从上层共享节点向下追踪跨组连线。",
      "进入一个虚线组，观察局部连接，再对照底部说明。"
    ],
    "design": {
      "layout": "左窄右宽的三面板对照，虚点分隔线区别方案，右侧重复三个组代表可扩展结构。",
      "shapes": "绿色矩形 P 与蓝色圆形 S 区分两类节点，紫色矩形表示中心交换，粉色虚线区域划定局部组。",
      "connectors": "无箭头直线表示连接；深蓝线跨组，棕色线在组内，两类线色与相应文字注释对应。",
      "color": "节点色表达类型，线色表达作用范围，不承担优劣或强弱编码。",
      "typography": "节点编号使用短无衬线，面板标题加粗；省略号表达未画出的中间编号，应保留编号规则。"
    },
    "parts": [
      {
        "id": "full-mesh",
        "name": "全连接对照",
        "meaning": "两种节点集合之间全部互连。",
        "adaptation": "改变节点数时按实际边集合重画。"
      },
      {
        "id": "central-switch",
        "name": "中心交换对照",
        "meaning": "两端节点经统一中介连接。",
        "adaptation": "如中心有冗余，应画出多个实例。"
      },
      {
        "id": "island-network",
        "name": "分组互连",
        "meaning": "局部组通过外部共享节点形成更大网络。",
        "adaptation": "设计真实跨组邻接表再布线。"
      },
      {
        "id": "island-cell",
        "name": "单个局部组",
        "meaning": "组内两类节点共享局部连接范围。",
        "adaptation": "复制时更新组编号及端口归属。"
      }
    ],
    "adaptation": [
      "三方案使用相同节点含义和可比较口径。",
      "先列出局部边和跨组边，避免为美观漏边。",
      "原有数字需全部按新规模替换，省略表示不意味着任意互连。"
    ],
    "example": {
      "scenario": "可用于多个园区的边缘计算资源组网比较。",
      "mapping": "圆形映射为计算节点，矩形映射为共享资源端口，局部组映射为园区，上层节点承接跨园区资源共享。",
      "structural_changes": "需按可行链路重新构建三方案，并另用实验图比较延迟；本图不承担性能证明。"
    },
    "checks": [
      "三面板中圆形和矩形的对象定义是否一致。",
      "棕色局部边和蓝色跨组边是否跨错边界。",
      "省略编号是否与正文规模及连通性要求冲突。"
    ],
    "editing": {
      "entry": "运行 make_figure.py；example.json 为配置，labels.json 查文字键，asset.json 查部件。使用 --parts 导出独立矢量部件。",
      "configurable": "labels 可改文字及字体；components 可设置 visible、dx/dy、attributes；elements 可按键改图元属性。移动量使用整图 viewBox 单位，重叠部件只选一个层级移动。",
      "code_required": "增删节点、调整连接和重排结构须在 customize() 中处理；新增图元使用唯一 data-asset-key，并登记至相应部件 element_keys。配置不会自动排版。",
      "fonts": "本图使用 Arimo-Bold.ttf、Arimo-Regular.ttf。font_size 是图元局部坐标单位，受既有缩放影响，不等于纸面 pt；改字后检查实际字宽与最终阅读尺寸。"
    },
