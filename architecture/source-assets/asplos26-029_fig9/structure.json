  "guide": {
    "asset_id": "architecture.source.asplos26-029_fig9",
    "title": "多核系统与计算引擎局部放大",
    "summary": "左侧以存储、片上网络和堆叠核心建立系统层级，右侧用虚线从核心内部计算引擎引出大幅细节。蓝色新增处理块嵌入灰白基线通路，突出解码与量化的具体位置。",
    "suitable_for": [
      "系统总览加一个关键模块的内部展开",
      "在既有硬件通路中突出新增算子或处理模块"
    ],
    "not_suitable_for": [
      "多个互不相关方案并列比较",
      "所有模块同等重要且不需要局部展开"
    ],
    "reading_order": [
      "从左端片外存储经片上网络进入多核栈",
      "定位核心中的蓝色Compute Engine",
      "沿虚线放大边界进入右侧",
      "从激活解码、权重输入读到点积阵列、输出和量化引擎"
    ],
    "design": {
      "layout": "左系统栈占约一半，右放大框占另一半；上下两根虚线把计算引擎边界映射到放大框。",
      "shapes": "双向空心大箭头表示片上网络，重叠圆角框表示多核，点积阵列采用重复小格。",
      "connectors": "左侧存储网络为双向连接；右侧激活向右、权重向下汇入阵列再经输出流向量化。",
      "color": "浅蓝计算引擎对应右侧重点模块；深蓝白字突出解码、编码和缩放归一化，其他组件灰白。",
      "typography": "主要为大号模块标签，竖排Activation/Decode与横排表头混合；蓝条白字更粗。"
    },
    "parts": [
      {
        "id": "memory-network",
        "name": "存储与片上网络",
        "meaning": "核心共享的外部存储与互联",
