    "adaptation": [
      "选择唯一需要展开的子模块，保持左框高亮区域与右框内容一致",
      "给深蓝模块建立明确的创新或改动含义，再决定哪些基线模块保留灰白",
      "重写数据表示和缓冲标签，检查右图真实处理先后",
      "改动计算引擎尺寸或放大布局时用代码重连两根虚线和全部输入输出"
    ],
    "example": {
      "scenario": "假设的边缘推理加速器精度处理图",
      "mapping": "左侧为多个推理核，右侧为解压、矩阵计算和重定标通路",
      "structural_changes": "若重定标放在阵列前，应重画相应路径与缓冲，不能沿用原输出后量化箭头"
    },
    "checks": [
      "虚线是否准确从左侧计算引擎边界发出",
