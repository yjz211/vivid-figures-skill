  "guide": {
    "asset_id": "architecture.source.nsdi26-140_fig8",
    "title": "流量管理与分层缓冲的三联展开",
    "summary": "左面板交代管理流程，中间展开包描述符、指针和数据三层内存，右面板解释混合存储的位图与控制器。它用同一缓冲概念连接系统层、数据结构层和实现层，适合复杂模块的逐层说明。",
    "suitable_for": [
      "一个子系统需要同时解释总体流程、数据结构和专用实现",
      "混合存储或资源调度器的三级展开"
    ],
    "not_suitable_for": [
      "面向非技术读者的单一概念图",
      "仅有少数模块且没有数据结构细节的系统"
    ],
    "reading_order": [
      "先读左图图例与管理器、调度器、读写控制器。",
      "沿左图圈号读入、有效写入、出队和读出。",
      "读中图从包描述符到指针链再到数据单元的对应。",
      "最后读右图位图层级、空闲链和两类存储控制器。"
    ],
    "design": {
      "layout": "三幅并排子图；左图用虚线投影引出中图，右图独立显示具体实现。",
      "shapes": "矩形模块、链表格子、圆形Head、层级位图及多个小圆节点组合，信息密度高。",
      "connectors": "左图红实线为数据路径、绿虚线为控制路径；中图黑箭头串链；右图红/紫线分别落到两类存储资源。",
      "color": "蓝紫区分左侧管理/调度，绿色用于缓冲底座，右图红色表示SRAM相关路径、紫色表示HBM相关路径。",
      "typography": "模块名称衬线体；位图数字、链表项和微小标注需保留明显字号层次。"
    },
    "parts": [
      {
        "id": "manager-panel",
        "name": "流量管理面板",
        "meaning": "从入口处理经缓冲管理到出口处理的完整子系统",
        "adaptation": "改请求流时一并改圈号和数据/控制图例"
      },
      {
        "id": "memory-panel",
        "name": "缓冲内存展开",
        "meaning": "包描述符、单元指针、数据三层关联",
        "adaptation": "重建链表顺序并核对空闲单元归属"
      },
      {
        "id": "hybrid-panel",
        "name": "混合存储实现面板",
        "meaning": "位图调度与双存储控制器的实现",
        "adaptation": "替换资源种类时同时改位图计数、链表与底层存储"
      }
    ],
    "adaptation": [
      "先决定是否确实需要三层视角，删面板时同步删除其跨面板投影线。",
      "将管理动作与数据结构实体分别命名，避免同名对象在三个面板中换含义。",
      "所有指针链、Head及空闲列表按新状态重建，不能只替换标题。",
      "以双栏或横版展示；长篇机制细节可拆为两图，共享颜色和术语。"
    ],
    "example": {
      "scenario": "假设展示冷热数据联合缓存。",
      "mapping": "左面板为访问调度，中间为缓存目录与块链，右面板为内存/SSD混合资源控制。",
      "structural_changes": "将SRAM/HBM计数与指针逻辑改为实际缓存状态，更新调度规则而非沿用位图数字。"
    },
    "checks": [
      "数据路径与控制路径的颜色和线型一致。",
      "Head与链表箭头顺序自洽，空闲和占用单元没有重复归属。",
      "左右对同一存储种类使用统一配色。",
      "最终尺寸能读清位图数字；否则应拆图。"
    ],
    "editing": {
      "entry": "make_figure.py 运行本图构建与 customize 入口；example.json 提供实例配置，labels.json 定位文字键，asset.json 定义部件及 element_keys。运行 python make_figure.py --config example.json --out . --parts。",
