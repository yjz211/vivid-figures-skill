  "guide": {
    "title": "分层系统栈与逐阶段中间产物",
    "summary": "左侧是一条从模型定义到执行接口的系统栈，叠框说明多个工作进程使用同样的栈；右侧对应展示各层产出的图、调度顺序和执行流。编号把责任层和中间产物绑定，使读者既能看懂模块归属，也能理解抽象如何逐步成为实际操作。",
    "suitable_for": [
      "软件分层到执行的转换说明",
      "每个阶段都有明确中间表示的编排流程"
    ],
    "not_suitable_for": [
      "只有最终输入输出的黑盒模型",
      "模块相互任意调用的网状系统"
    ],
    "reading_order": [
      "先识别左侧应用与通信两层分组",
      "从模型向下读并行策略和调度器",
      "按编号横向查看右侧对应的图与顺序",
      "继续向下通过接口到执行流，核对跨进程重复关系"
    ],
    "design": {
      "layout": "左窄栈右产物，两列按阶段高度对齐；左侧叠片提供重复进程背景，橙色侧括号分配右栏范围。",
      "shapes": "圆角淡黄块是系统职责，右侧小矩形与箭头是中间表示；圆形数字用来跨栏定位。",
      "connectors": "左侧向下箭头表示逐层处理，右侧依赖边与执行箭头属于不同产物，不应合并为一条物理链。",
      "color": "淡黄统一标识系统层，明黄突出层级名，橙色框及编号帮助定位，没有性能高低编码。",
      "typography": "衬线正文配少量粗体标题，右栏公式和小任务标记较密，优先缩短说明而非持续缩小字体。"
    },
    "adaptation": [
      "先确定每层输出什么中间产物，再安排左右对应位置",
      "层数改变时同步调整编号、括号和所有横向说明",
      "多进程叠框只表示重复结构，不暗示进程数",
      "右栏若无真实中间表示，可删去而不要编造依赖小图"
    ],
    "example": {
      "scenario": "可用于说明多机器人任务程序从计划到执行的转换。",
      "mapping": "上层映射任务模型、机器人分工和动作调度，下层映射设备接口和动作执行，右栏分别展示任务图与动作序列。",
      "structural_changes": "将通信操作换成真实动作命令，保留动作编号映射；若机器人栈异构，则改为并列栈而不使用重复叠片。"
    },
    "checks": [
      "编号是否唯一且对应正确左右内容",
      "任务标识从依赖图到执行流是否可追踪",
      "层级括号是否覆盖实际所属模块"
    ],
