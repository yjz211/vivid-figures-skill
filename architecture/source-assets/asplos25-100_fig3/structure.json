  "guide": {
    "title": "从迭代过程到内部算子的三级展开",
    "summary": "三栏从宏观迭代逐步放大到模块链和算子图。左栏展示初始化与重复生成，中栏解释单个处理块及读出，右栏展开两个关键计算子结构。它适合说明嵌套算法层次，但右栏具有明确运算语义，不能在迁移时只替换名称而保留不对应的矩阵乘和残差连接。",
    "suitable_for": [
      "神经网络推理流程与内部计算",
      "确有三级粒度的算法结构说明"
    ],
    "not_suitable_for": [
      "普通业务功能架构",
      "不了解内部算子仍希望仅换名的场景"
    ],
    "reading_order": [
      "先从左栏识别一次初始化和重复迭代",
      "用中栏理解单个重复块的处理链",
      "在右上跟随投影、缓存与注意力计算",
      "在右下读取门控前馈及输出汇合"
    ],
    "design": {
      "layout": "三栏纵向对齐，左为时间过程，中为模块流程，右为数学细节；细分区边界分隔观察尺度。",
      "shapes": "叠片矩形表示重复权重或缓存，圆中加号和乘号表示不同运算，×N括号表示重复层。",
      "connectors": "黑色细箭头是张量流，绕行线是残差或缓存访问；交叉线不能自动解释成相连。",
      "color": "绿色强调主要计算模块，黄色强调归一化或合并，蓝色用于权重，桃色用于缓存；最终以标签核对。",
      "typography": "衬线正文配数学斜体及下标，多种运算符必须保留可用字形；右栏最密，需单独检查缩版清晰度。"
    },
    "adaptation": [
      "先写清每栏的粒度以及放大对象，再保留需要的重复括号",
      "逐条对照数学公式检查右栏运算顺序与张量维度",
      "删除模型不存在的缓存、位置编码或采样模块",
      "若用作其他算法，须重构右栏算子图而非仅换标题"
    ],
    "example": {
      "scenario": "可用于说明一个自回归时间序列预测模型的推理结构。",
      "mapping": "左栏映射历史窗口编码与滚动预测，中栏展示实际预测块，右栏展开确实采用的注意力和前馈算子。",
      "structural_changes": "替换分词读出为数值预测头，删除不适用的词表采样；缓存和位置编码是否保留由实现决定。"
    },
    "checks": [
      "宏观流程与单块内部顺序是否一致",
      "乘号加号及残差路径是否对应公式",
      "缓存和重复次数是否属于当前模型"
    ],
