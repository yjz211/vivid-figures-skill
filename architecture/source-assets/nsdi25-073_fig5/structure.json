  "guide": {
    "asset_id": "architecture.source.nsdi25-073_fig5",
    "title": "同一分层栈在不同拆分边界下的比较",
    "summary": "四个象限展示共置基线和三种跨端拆分方式。每格重复相同层级与颜色，只改变哪些层留在本地、哪些移到远端，以及跨端连接落在哪层。对照成立的前提是层级定义一致，因此它首先是部署边界比较图，而不是四条顺序执行流程。",
    "suitable_for": [
      "比较同一系统在不同层级拆分的部署方式",
      "边缘云协同或软硬件解耦方案说明"
    ],
    "not_suitable_for": [
      "四种本来就没有共同层次的方法比较",
      "需用图直接证明方案性能优劣"
    ],
    "reading_order": [
      "先读左上完整栈，建立层名与颜色对应。",
      "右上观察高层拆分，找跨端链路落点。",
      "左下看接口中介与远端服务如何配合。",
      "右下检查仅资源端外置时本地还保留哪些层。"
    ],
    "design": {
      "layout": "二乘二对照网格，粗虚线分隔方案；每个拆分方案内部按本地和远端并列。",
      "shapes": "薄矩形重复成层，层高尽量一致；额外代理层单独呈现，不能隐藏在空白间距中。",
      "connectors": "双向箭头表示跨端连接，竖线连接本地层次；箭头穿越哪层就是比较重点。",
      "color": "蓝色应用、绿色框架、橙色接口、黄色驱动、粉色中介贯穿各格；新图必须保留同层同色。",
      "typography": "方案标题比层名醒目；层名宜短且四格一致，网络技术标签放在连线旁而非层内部。"
    },
    "parts": [
      {
        "id": "baseline",
        "name": "共置基线",
        "meaning": "所有主要层位于同一端。",
        "adaptation": "用作层级字典；先改这里再同步其余三格。"
      },
      {
        "id": "graph-split",
        "name": "高层拆分",
        "meaning": "较高逻辑层之间进行跨端连接。",
        "adaptation": "说明远端是否复制上层运行环境。"
      },
      {
        "id": "api-split",
        "name": "接口拆分",
        "meaning": "本地代理与远端服务承接调用。",
        "adaptation": "显式保留新增客户端和服务端层。"
      },
      {
        "id": "hardware-split",
        "name": "资源拆分",
        "meaning": "上层栈留本地，仅底层资源远置。",
        "adaptation": "改真实总线或网络接口，不沿用不适用协议。"
      }
    ],
    "adaptation": [
      "定义统一层级清单，逐格标记本地、远端或两侧都有。",
      "把新增代理层与原有层区别画出，不能靠相同色块掩盖成本。",
      "方案数变化时重排整个网格，避免空象限被误认为缺失结果。"
    ],
    "example": {
      "scenario": "假设比较视觉检测系统在工厂与云端的部署。",
      "mapping": "共同层为检测应用、推理框架、设备接口和计算资源；三种方案分别远置框架、接口调用或资源。",
      "structural_changes": "按真实部署重画四格，跨端链路统一写实际网络；硬件远置若不成立则换成另一种可行方案。"
    },
    "checks": [
      "同一层在四格中名称和颜色是否一致。",
      "跨端箭头落点是否准确体现拆分层级。",
      "代理层是否只出现在需要它的方案中，且两端成对。"
    ],
    "editing": {
      "entry": "以 make_figure.py 为入口，example.json 提供编辑配置，labels.json 用于查文字键，asset.json 对应下列部件。",
      "configurable": "labels 改指定文字与字号；components 可显隐、平移和改属性；elements 修改单个矢量对象。平移保留固定几何，不会自动重新布线。",
      "code_required": "修改层数、方案数或拆分位置时需要重排四格层条与跨端连线。 必须在 customize() 中处理新增矢量对象及连接，不能只扩大文字框。",
      "fonts": "当前字体映射使用 Arimo-Bold.ttf, Arimo-Regular.ttf；换标签后按最终插入宽度检查字宽、上下标和边界，不直接继承小字号。"
    },
    "display_code": "VA-091"
  },
