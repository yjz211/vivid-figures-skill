      }
    ],
    "adaptation": [
      "先定义工作者类别及形状图例，再画空间和时间安排。",
      "用具体实例校对同一任务是否在两个调度视图中都可追踪。",
      "删去无实际职责的管理项，把控制器保持为可解释的执行组织。"
    ],
    "example": {
      "scenario": "假设展示机器人仓库任务编排。",
      "mapping": "工作者为搬运、拣选、质检任务，空间图显示区域分派，时间图显示机器人任务切换。",
      "structural_changes": "通信底座改为消息网络，启动层改为任务运行服务；重新画合法依赖与资源冲突。"
    },
    "checks": [
      "三类形状在空间和时间图中是否始终同义。",
      "工作流到策略和控制器的两条依赖是否都真实存在。",
      "时间图是否把同一资源上的冲突任务画成重叠而未说明。"
    ],
    "editing": {
      "entry": "以 make_figure.py 为入口，example.json 提供编辑配置，labels.json 用于查文字键，asset.json 对应下列部件。",
      "configurable": "labels 改指定文字与字号；components 可显隐、平移和改属性；elements 修改单个矢量对象。平移保留固定几何，不会自动重新布线。",
      "code_required": "改变工作者类型、内部能力或时空计划时需重画重复形状、虚线分组及时间轴。 必须在 customize() 中处理新增矢量对象及连接，不能只扩大文字框。",
      "fonts": "当前字体映射使用 Arimo-Regular.ttf；换标签后按最终插入宽度检查字宽、上下标和边界，不直接继承小字号。"
    },
