  "guide": {
    "asset_id": "architecture.source.osdi26-044_fig4",
    "title": "工作者封装与时空调度展开",
    "summary": "顶部程序入口产生工作者集合与工作流，中部分析策略和控制器协作，下部用两种小图把抽象调度展开为资源分配与时间安排，最底通信和启动层提供运行基础。叠片表示多个同型工作者，小图中不同形状表示工作者类别，两者共同避免把系统只画成大方框。",
    "suitable_for": [
      "具有多个工作者类型和统一执行编排的平台",
      "需要同时说明空间资源分配与时间复用的调度"
    ],
    "not_suitable_for": [
      "没有可重复任务对象的串行算法",
      "只有时间甘特图、没有系统控制层的结果展示"
    ],
    "reading_order": [
      "顶部读用户程序入口，区分工作者定义与工作流。",
      "中部从工作者观测进入策略，再到执行控制器。",
      "下部并列看空间编排和时间切换，两者联合形成执行计划。",
      "最底核对通信服务与启动服务支撑什么。"
    ],
    "design": {
      "layout": "顶部单条入口，中部三列决策结构，下部宽面板展开调度，再用两条底座收束。",
      "shapes": "错位圆角叠卡表示多个工作者；方形、菱形、三角形表示任务类别；虚线框按同类或资源分组。",
      "connectors": "空心大箭头跨层传递抽象流程，细箭头交代策略和控制依赖；时间轴只属于右侧小图。",
      "color": "浅绿工作者、浅蓝工作流、浅灰内部管理块；小形状颜色跨空间图和时间图保持类别一致。",
      "typography": "内部管理项使用短行；最小符号旁保留类别图例，时间轴标签不能和宽面板标题挤在一起。"
    },
    "parts": [
      {
        "id": "program-interface",
        "name": "程序入口",
        "meaning": "用户表达任务与执行工作流。",
