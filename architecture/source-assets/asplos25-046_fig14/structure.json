  "guide": {
    "asset_id": "architecture.source.asplos25-046_fig14",
    "title": "租户配额到实体资源池映射",
    "summary": "上方三个不同规模租户分别展示计算和内存资源，下方聚合到统一实体池。保障份额与超额共享区通过区域边界区分，使用状态通过灰绿粉三色区分，适合解释逻辑配额和实际资源占用之间的关系。",
    "suitable_for": [
      "多租户保障配额与共享超额资源说明",
      "计算和内存两种资源需要并行展示的方案"
    ],
    "not_suitable_for": [
      "颜色即可证明超额配置安全性的结论图",
      "需要精确容量比较却没有数值支撑的统计图"
    ],
    "reading_order": [
      "先读顶端三色图例，区分闲置、保障使用和超额使用。",
      "横向比较三个租户的计算行与内存行。",
      "沿双向映射箭头下看实体资源池。",
      "最后对照池内保障区和黄色超额共享区的边界。"
    ],
    "design": {
      "layout": "上部三卡片宽度随展示内容变化，下部一张总池；每卡都按计算、内存两行对齐。",
      "shapes": "芯片图标代表计算槽，横条代表内存分区，虚线内部框标逻辑份额或可用位置。",
      "connectors": "双向箭头表示逻辑与实体映射，不是实时数据传输；下方邻接关系不是操作顺序。",
      "color": "灰表示未充分使用，绿表示已用保障份额，粉表示已用超额份额；黄色底层区域专指超额池。",
      "typography": "租户名加粗；计算、内存行标签竖排，短配额标签避免挤占芯片内部。"
    },
    "parts": [
      {
        "id": "allocation-key",
        "name": "状态图例",
        "meaning": "定义三种资源使用状态。",
        "adaptation": "改状态名必须同时改全部芯片和内存块，别把容量区域颜色混入图例。"
      },
      {
        "id": "tenant-one",
        "name": "小规模租户",
        "meaning": "展示少量保障与超额位置。",
        "adaptation": "可改低配额服务，注意计算与内存比例不应由框宽自动推断。"
      },
      {
        "id": "tenant-two",
        "name": "中规模租户",
        "meaning": "具有更多保障计算位置的配置。",
        "adaptation": "按真实配额调整芯片数和内存分段。"
      },
      {
        "id": "tenant-three",
        "name": "大规模租户",
        "meaning": "同时拥有较多保障与超额资源的租户。",
