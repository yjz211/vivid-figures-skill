  "guide": {
    "asset_id": "architecture.source.asplos26-088_fig14",
    "title": "双泳道批次交叠执行时间线",
    "summary": "两条执行泳道在同一时间方向上错位展开，以浅至深绿表示不同批次。堆叠卡片和下方小格突出每批内的多对象，斜箭头表达阶段依赖；白色末端与开头对象表示空闲。",
    "suitable_for": [
      "同一批次经过两种处理单元且相邻批次可以交叠",
      "解释流水线启动、稳定执行和排空的定性过程"
    ],
    "not_suitable_for": [
      "要求精确时长比例的甘特图",
      "没有前后依赖、只是两个独立并行任务的系统"
    ],
    "reading_order": [
      "先识别左侧上下两条执行泳道。",
      "从左往右看上方 ITU 到下方 SCU 的斜向交接。",
      "结合右侧图例区分三个批次和白色空闲，最后确认时间方向。"
    ],
    "design": {
      "layout": "两泳道居中，左侧用两行粗体名称，右侧四行图例；底部水平箭头统一时间方向。",
      "shapes": "上层叠置矩形表示测试批，下层带多格的叠置矩形表示计算批。",
      "connectors": "黑色斜箭头从上泳道指向稍后下泳道；底部箭头只表示时间，省略号表示中间批次。",
      "color": "白色表示 Idle，浅绿、中绿、深绿分别表示三组对象，不表示性能优劣。",
      "typography": "无衬线字体；泳道名称加粗，块内 ITU、SCU 为大写简写，图例使用区间编号。"
    },
    "parts": [
      {
        "id": "processing-lanes",
        "name": "双泳道批次交接主体",
        "meaning": "两条泳道、批次叠层与斜向交接箭头共同表达依赖和交叠。",
        "adaptation": "整体抽取以保留跨泳道箭头；重排阶段时同步移动两个泳道及其交接关系。"
      },
      {
        "id": "batch-legend",
        "name": "空闲与批次图例",
        "meaning": "四条图例解释白色和三种绿。",
        "adaptation": "改批次数时同步更新图例颜色及区间。"
      },
      {
        "id": "time-axis",
        "name": "统一时间箭头",
        "meaning": "两泳道共享同一个向右时间方向。",
        "adaptation": "定量化时需另建刻度，不能只给现有块宽强加时间单位。"
      }
    ],
    "adaptation": [
      "先列出阶段依赖与可交叠的批次，再决定白色空闲应出现在哪一端。",
      "阶段名变长时扩大左侧标签空间，避免压缩实际批次。",
      "新增第三泳道或精确时间尺度需要代码重排，不能仅改 SCU 标签。"
    ],
    "example": {
      "scenario": "假设场景：数据预取与批次模型推理交叠。",
      "mapping": "ITU 改为预取，SCU 改为推理，三档绿色表示批次编号，白色保留为空闲。",
      "structural_changes": "按预取完成时间重设斜箭头及下排偏移，若有预取失败再单独增加异常分支。"
    },
    "checks": [
      "每个批次在两个泳道中的颜色应一致。",
      "白色空闲不能被误标为最终批次。",
      "斜箭头终点必须在依赖阶段之后。",
      "省略号不代表零时长，不可据图估算加速比。"
    ],
    "editing": {
      "entry": "运行 make_figure.py 读取 example.json 的迁移配置；labels.json 登记文字，asset.json 登记部件。使用 --parts 可导出部件；准备后的工作副本通过 render_architecture.py 输出论文图。",
      "configurable": "labels、components 可设置文字、配色、显隐和位移；不会自动加宽文本框或重排连线。先保留示例几何再逐项调整。",
      "code_required": "改变节点数量、分支和跨区域连线须修改 customize(root, context)。新增元素设置 data-asset-key，并加入对应部件的 element_keys；共享边框与跨区箭头保留整图级，避免重叠移动。",
      "fonts": "无衬线字体；泳道名称加粗，块内 ITU、SCU 为大写简写，图例使用区间编号。 最终字体文件以构建映射为准；局部 font_size 受 SVG 变换影响，不直接等于纸面 pt。本批构建已确认并嵌入完整字体：texgyreheros-bold.otf, texgyreheros-regular.otf。映射可能改变原字形和字宽，需按实际论文尺寸复核。"
    },
