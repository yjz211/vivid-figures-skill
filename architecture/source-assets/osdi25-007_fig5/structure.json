  "guide": {
    "asset_id": "architecture.source.osdi25-007_fig5",
    "title": "共享层级轴的三方案接口对照",
    "summary": "三个方案按硬件中立层、通用接口、硬件专属层与数据结构四行对齐。中列用橙色突出新增接口，蓝色虚点框显示耦合范围；左列的虚线空框明确表达没有接口。其价值在于用相同坐标比较架构分层。",
    "suitable_for": [
      "对比旧系统、新增抽象层与已有类比方案",
      "说明解耦前后接口位于哪一层"
    ],
    "not_suitable_for": [
      "需要箭头表达执行顺序的流程",
      "各方案层级无法一一对应的对比"
    ],
    "reading_order": [
      "先读左侧四个公共行标签。",
      "读左列整体耦合栈及 No Interface。",
      "读中列橙色 EMT 和 MMU Driver，比较蓝色耦合框范围。",
      "读右列 VFS 类比并对照上下行。"
    ],
    "design": {
      "layout": "左侧窄行标题栏加三列方案，共用水平分隔线，底部给方案名。",
      "shapes": "实体矩形表示接口，虚线灰框表示结构缺位，蓝色圆角虚点框标示耦合范围。",
      "connectors": "没有方向箭头，关系依赖严格的行列对齐与包围范围；不能给分隔线附会数据流。",
      "color": "橙色表示新增层，淡蓝色虚点区域表示耦合；灰白底保持比较中立。",
      "typography": "方案名与接口名突出，路径和硬件实例使用较小文字；源印刷图正文呈衬线，路径呈等宽角色。"
    },
    "parts": [
      {
        "id": "row-axis",
        "name": "四层公共比较轴",
        "meaning": "所有方案共用的层级语义",
        "adaptation": "更换行业时先统一每行含义，保持跨列一致。"
      },
      {
        "id": "baseline-stack",
        "name": "紧耦合基线列",
        "meaning": "从中立代码贯穿到硬件的耦合范围及接口缺位",
        "adaptation": "可替换为旧流程，保留缺位框明确缺少的抽象。"
      },
      {
        "id": "proposed-stack",
        "name": "新增接口方案列",
        "meaning": "新接口与可替换驱动之间的分层",
        "adaptation": "新增候选实现时同步扩宽驱动行与下层框。"
      },
      {
        "id": "analogy-stack",
        "name": "已有接口类比列",
        "meaning": "以成熟接口栈解释新设计",
