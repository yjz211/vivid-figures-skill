      },
      {
        "id": "encoding-key",
        "name": "新增与耦合图例",
        "meaning": "橙色提出层与蓝色耦合两种视觉语义",
        "adaptation": "图例与全部区域同时换色，不能混用含义。"
      }
    ],
    "adaptation": [
      "先写四行的统一比较口径，再填三个方案。",
      "只在真正缺少接口的位置使用虚线空框。",
      "耦合范围变化需要重画包围框，不能只移动接口矩形。",
      "公共灰底与分隔线留整图，整列移动须同步调整列宽和底部标题。"
    ],
    "example": {
      "scenario": "假设的多厂商传感平台改造",
      "mapping": "左列为厂商绑定采集栈，中列为统一适配接口，右列为已有设备驱动框架。",
      "structural_changes": "将硬件实例替换为传感器类型，并按实际耦合边界重新绘制蓝框。"
    },
    "checks": [
      "三列同一行是否含义相同。",
      "No Interface 是否确实表达缺位而非未实现。",
      "橙色是否只用于本次新增层。",
      "路径与小实例标签是否溢出窄格。"
    ],
    "editing": {
      "entry": "运行 make_figure.py；example.json 保存本场景配置，labels.json 提供文字定位键，asset.json 保存部件及成员定义。使用 --parts 同时导出部件。",
      "configurable": "通过 labels 改文字，通过 components 改配色、显隐与位移；配置不会按文字长度自动重排，需复查本图的间距和连接。",
      "code_required": "增删结构、调整连线或重排布局需在 customize(root, context) 中编辑 SVG。新增元素须有 data-asset-key，并加入对应部件的 element_keys；共享线框保留整图时不可随多个部件重复移动。",
      "fonts": "原印刷预览为衬线正文和等宽路径，浏览器直接打开源 SVG 会回退；须检查路径字符宽度与字体映射。 局部 font_size 使用源坐标尺度，不等于论文纸面 pt。本批构建已确认并嵌入完整字体：Inconsolata-Regular.ttf, Tinos-Bold.ttf, Tinos-Regular.ttf。映射可能改变原字形和字宽，需按实际论文尺寸复核。"
    },
