  "guide": {
    "asset_id": "architecture.source.asplos25-140_fig7",
    "title": "离线配置与在线多执行器服务",
    "summary": "把一次性准备和持续请求处理画在同一张宽图中。左侧配置影响上方初始化与中部调度；队列进入执行器后分批选择模型，叠层面板表达多个同类执行器。核心是区分静态设置、动态任务和控制关系。",
    "suitable_for": [
      "需要预先测量配置的模型服务",
      "多模型选择与批处理共存的调度系统"
    ],
    "not_suitable_for": [
      "单一模型的一次调用",
      "需要准确表达每项耗时的时间线"
    ],
    "reading_order": [
      "先看图例，区分模块、静态信息和请求。",
      "从左侧配置卡追踪上方初始化链。",
      "从底部请求入口进入队列。",
      "沿分批与管理模块到右侧模型池。"
    ],
    "design": {
      "layout": "左窄右宽；上部初始化带横跨在线模块，下部是队列到执行器。",
      "shapes": "请求以金色阶梯卡片表示；模型用小型节点网络；执行器背后叠片表示同构副本。",
      "connectors": "实线传数据、虚线传控制；编号用于阅读顺序，不表示耗时。",
      "color": "深蓝灰模块、粉色静态信息、金色动态信息，浅青面板仅作分组。",
      "typography": "模块名加粗，控制注释较小；宽图缩为单栏会损失队列与连线标签。"
    },
    "parts": [
      {
        "id": "offline-profile",
        "name": "离线配置",
        "meaning": "记录可复用的测量与路由信息。",
        "adaptation": "替换为当前配置字段，不能把未测量性能写成事实。"
      },
      {
        "id": "initialization",
        "name": "初始化横带",
        "meaning": "创建执行单元并装载模型。",
        "adaptation": "与逐请求运行分开，删除不需要的初始化步骤。"
      },
      {
        "id": "request-control",
        "name": "调度和队列",
        "meaning": "组织进入系统的动态任务。",
        "adaptation": "队列卡改成真实任务单元及优先级。"
      },
      {
        "id": "batch-manager",
        "name": "分批与模型管理",
        "meaning": "将任务需求和可用模型连接。",
        "adaptation": "没有分批机制时删除相应节点与边。"
      },
      {
        "id": "expert-pool",
        "name": "模型池",
        "meaning": "并列多个可选择计算模型。",
        "adaptation": "内部节点网络应换成当前模型结构。"
      },
      {
        "id": "executor-stack",
        "name": "执行器叠层",
        "meaning": "多个执行器共享内部组成。",
        "adaptation": "实例数变化时同时调整叠片、标签及路由。"
      }
    ],
    "adaptation": [
      "先定义静态配置和运行期变化的边界。",
      "请求编号改成新情景的例子，清除无关章节号。",
      "改变模型数量时重新排列小网络和分批出口。"
    ],
    "example": {
      "scenario": "假设用于城市多传感器预警服务。",
      "mapping": "离线配置存放传感器可靠性与模型成本，请求队列装入时间窗，模型池包含洪水、交通和空气质量模型。",
      "structural_changes": "把专家网络换成三种预测模型图标，并按实际任务依赖重画选择关系。"
    },
    "checks": [
      "图例的实虚线约定贯穿所有连线。",
      "初始化带不遮盖在线请求入口。",
      "叠层执行器没有被误读为串行阶段。"
    ],
