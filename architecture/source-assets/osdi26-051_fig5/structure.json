      }
    ],
    "adaptation": [
      "先明确新情景中借用者、出借者与资源目录是否真实存在。",
      "重写协议步骤及其箭头类型，再更新红色编号；不要只替换设备名。",
      "单设备内部结构放左侧，跨设备的资源流留在右侧全图。",
      "底部内存带与跨区连线属于共享结构，移动局部部件后需手工接回。"
    ],
    "example": {
      "scenario": "假设：边缘推理节点借用邻近节点的空闲缓存。",
      "mapping": "主机映射为调度服务，两个设备映射为繁忙/空闲节点，描述符映射为资源目录。",
      "structural_changes": "若节点只经网络共享缓存，应将一致性内存层改为目录服务并重画访问路径，不能保留 CXL 语义。"
    },
    "checks": [
      "四类箭头颜色与图例一致。",
      "步骤号 1–8 的起止对象及必要顺序与新协议一致。",
      "底部细文字在论文尺寸仍可辨识。",
      "主机、互连和内存边界不可被跨区线误读为单向步骤。"
    ],
    "editing": {
      "entry": "make_figure.py 调用共享矢量运行库；example.json 保存实例配置，labels.json 列出可替换文本，asset.json 保存部件成员及边界。",
      "configurable": "labels 可替换文字；components 可调整已登记部件的配色、显隐、位移。配置不会自动重排连线、容器或长标签。",
      "code_required": "拓扑、对象数量及容器改变需在 customize(root, context) 编辑 SVG；新增对象须设置 data-asset-key，并将其加入相关部件 element_keys。跨区连线应随端点另行调整，避免重叠部件重复移动同一元素。",
      "fonts": "观察到的字体层次见本图 typography；最终字体文件由构建映射提供。局部 font_size 是 SVG 坐标下的字号，不能直接当作论文纸面 pt；替换字体后检查实际字宽。本批构建已确认并嵌入完整字体：Carlito-BoldItalic.ttf, Carlito-Italic.ttf, Carlito-Regular.ttf。映射可能改变原字形和字宽，需按实际论文尺寸复核。"
    },
