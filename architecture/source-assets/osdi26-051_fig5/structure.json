  "guide": {
    "asset_id": "architecture.source.osdi26-051_fig5",
    "title": "主机、借用节点与共享内存的分层协议图",
    "summary": "左侧窄栏拆解单个设备的计算端和数据端，右侧由主机、互连、借用/出借设备及共享内存组成四层。红色步骤号覆盖多类流，适合把设备组成和资源借用协议放在同一图内。",
    "suitable_for": [
      "两个对等节点借用计算或内存且数据路径仍需单独标示",
      "主机驱动协调设备资源池的分层系统"
    ],
    "not_suitable_for": [
      "只需单一路径的简短流程",
      "没有共享地址空间却仍想沿用底部一致性内存标签"
    ],
    "reading_order": [
      "先读顶端四类箭头图例，区分控制、命令、数据和元数据。",
      "左侧了解设备内部两层，再读右上主机与驱动。",
      "沿右侧借用者和出借者之间的红色编号追踪交互。",
      "最后读底部共享内存、可借出内存和空闲描述符。"
    ],
    "design": {
      "layout": "窄左栏设备剖面配宽右栏系统分层；底部内存带横贯全图。",
      "shapes": "虚线色块表示计算/数据端，矩形表示主机与驱动，浅色长条表示互连和内存。",
      "connectors": "不同颜色箭头在层间跨越；步骤号是全图协议索引，不能按几何左右顺序理解。",
      "color": "橙色控制、蓝色命令、绿色数据、黑色元数据；红色用于步骤号和部分强调文字，绿色/紫色区分设备两端。",
      "typography": "紧凑无衬线主体，角色名与若干层标题带斜体；红色步骤数字比模块文字醒目。"
    },
    "parts": [
      {
        "id": "flow-legend",
        "name": "四类流图例",
        "meaning": "定义箭头颜色的含义",
        "adaptation": "改流程类型时同时改所有同色连线与图例"
      },
      {
        "id": "device-cutaway",
        "name": "设备组成剖面",
        "meaning": "单设备计算端和数据端的纵向分工",
        "adaptation": "保留两层对齐，替换处理器、内存、传输和存储模块"
      },
      {
        "id": "host-driver",
        "name": "主机与驱动",
        "meaning": "驱动在主机内做重定向和负载分配",
