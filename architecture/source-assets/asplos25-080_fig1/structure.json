  "guide": {
    "asset_id": "architecture.source.asplos25-080_fig1",
    "title": "双端事件通知与共享状态交互",
    "summary": "左侧发送端、中央共享状态、右侧接收端构成三个竖区。编号沿弧形和折线箭头穿过代码、通知状态、底部总线及接收处理，展示事件从发起到处理后恢复的过程。与普通流水线相比，它强调两端程序和底层通知机制交织。",
    "suitable_for": [
      "事件通知涉及共享状态和接收处理",
      "需要把短代码片段放入端点内部解释"
    ],
    "not_suitable_for": [
      "多对多网络拓扑",
      "没有确认或状态恢复的单向数据搬运"
    ],
    "reading_order": [
      "先辨认发送、共享状态及接收三栏。",
      "按前几个编号跟随发送端更新共享标志并发出通知。",
      "沿底部弧线到接收端，再读内部处理序列。",
      "最后查看处理程序与状态标志的恢复关系。"
    ],
    "design": {
      "layout": "接收端比发送端更宽，中间狭长状态栏独立；底部大弧线绕开内部代码。",
      "shapes": "外矩形为端点，浅色嵌套框为处理区，虚线框为代码片段，窄格表示共享标志。",
      "connectors": "黑色有向弧线联系远距离状态，圆形编号给出阅读次序；箭头跨过框时不表示归属。",
      "color": "浅绿色承载处理代码，浅黄色承载底层控制寄存器，粉色窄栏突出共享状态，黑白号码保持高对比。",
      "typography": "代码用等宽字体，模块用无衬线；保留缩进与换行，不能将长代码强塞进现有框。"
    },
    "parts": [
      {
        "id": "sender",
        "name": "发送端",
        "meaning": "程序发起操作并关联本地通知寄存器。",
        "adaptation": "把调用与发送状态作为一组修改。"
      },
      {
        "id": "shared-state",
        "name": "共享状态",
        "meaning": "端点间可见的待处理位和通知标志。",
        "adaptation": "按协议改字段，并解释谁写谁读。"
      },
      {
        "id": "receiver",
        "name": "接收端",
        "meaning": "接收机制、处理代码和完成标志并列。",
        "adaptation": "替换内部状态机时重编步骤。"
      },
      {
        "id": "system-bus",
        "name": "底部通道",
        "meaning": "跨端点传递通知的外绕路径。",
        "adaptation": "与共享状态访问区分，不误作同一数据通道。"
      }
    ],
    "adaptation": [
      "先列出端点动作及共享字段的读写顺序。",
      "保留两类通道的视觉区别：状态访问和通知传递。",
      "步骤数变化时重排圆形号码与路径，必要时放大接收区。"
    ],
    "example": {
      "scenario": "可用于任务生产者向工作线程发事件。",
      "mapping": "发送代码映射为提交任务，共享栏映射为待处理队列标志，接收代码映射为任务处理与确认。",
      "structural_changes": "需替换硬件专用寄存器及返回指令，并补画队列实际所在位置。"
    },
    "checks": [
      "每个编号是否紧贴唯一的动作或箭头。",
      "共享标志是否有明确读者、写者和清除时机。",
      "接收端代码是否与恢复箭头互相遮挡。"
    ],
    "editing": {
      "entry": "运行 make_figure.py；example.json 为配置，labels.json 查文字键，asset.json 查部件。使用 --parts 导出独立矢量部件。",
      "configurable": "labels 可改文字及字体；components 可设置 visible、dx/dy、attributes；elements 可按键改图元属性。移动量使用整图 viewBox 单位，重叠部件只选一个层级移动。",
      "code_required": "增删节点、调整连接和重排结构须在 customize() 中处理；新增图元使用唯一 data-asset-key，并登记至相应部件 element_keys。配置不会自动排版。",
      "fonts": "本图使用 Arimo-Regular.ttf、Inconsolata-Regular.ttf。font_size 是图元局部坐标单位，受既有缩放影响，不等于纸面 pt；改字后检查实际字宽与最终阅读尺寸。"
    },
