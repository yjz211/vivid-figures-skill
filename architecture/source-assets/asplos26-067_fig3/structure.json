  "guide": {
    "asset_id": "architecture.source.asplos26-067_fig3",
    "title": "异构域通过共享目录完成请求响应",
    "summary": "左右两种本地协议域共同连接上方全局服务，横跨两域的桥接带表明转换职责。编号箭头叠在部署结构上，讲述一次请求从本地发起、跨域转发、响应和回写的完整链。颜色编码协议归属，不编码请求先后；顺序由数字承担。",
    "suitable_for": [
      "异构节点经桥接层共享状态的协议",
      "需要在系统部署图上解释一次完整事务"
    ],
    "not_suitable_for": [
      "没有共享目录的点对点通信",
      "只想展示模块静态包含关系的总览"
    ],
    "reading_order": [
      "先读底部三色图例，再确认左右本地域和顶部共享域。",
      "从左下外部触发进入本地缓存及目录。",
      "沿编号走上方全局转发和右侧处理。",
      "继续跟随返回及回写箭头直到左侧完成。"
    ],
    "design": {
      "layout": "下方双域并列，上方单一共享域，蓝色虚线桥带压在域交界处；框的交叠表达跨域职责。",
      "shapes": "斜线底纹表示协议范围，内部矩形表示缓存或目录，编号圆标事务步骤。",
      "connectors": "黑有向线表达请求、转发、响应和回写；相邻双向路径分别看标签，不能由线粗推断优先级。",
      "color": "粉色、紫色、金色对应三类协议；蓝色桥带只分组转换功能，不能混成第四种协议图例。",
      "typography": "协议标签与编号紧邻，标题用较重字；新标签过长时优先改走线而非压小所有文字。"
    },
    "parts": [
      {
        "id": "global-service",
        "name": "全局协调服务",
        "meaning": "共享目录连接状态存储或控制器。",
        "adaptation": "改成真实共享服务，保留目录与存储的职能区别。"
      },
      {
        "id": "left-domain",
        "name": "第一本地域",
        "meaning": "本地缓存、目录与跨域控制组合。",
        "adaptation": "换为第一种协议，更新该域所有请求响应名。"
      },
      {
        "id": "right-domain",
        "name": "第二本地域",
        "meaning": "结构类似但协议不同的另一组节点。",
        "adaptation": "保留异构差别，不只更换域标题。"
      },
      {
        "id": "bridge",
        "name": "桥接范围",
        "meaning": "横跨两个域的协议转换入口。",
        "adaptation": "明确哪些模块由桥管理，必要时收紧虚线边界。"
      },
      {
        "id": "protocol-key",
        "name": "协议图例",
        "meaning": "三种颜色说明消息归属。",
        "adaptation": "与域底纹和编号底色同步更新。"
      }
    ],
    "adaptation": [
      "先列一条真实事务序列，再逐条给箭头编号。",
      "区分触发事件与内部消息，外部触发不必伪装成模块。",
      "改变桥接职责时调整边界和模块归属，不仅替换蓝色标题。"
    ],
    "example": {
      "scenario": "假设说明两个仓库系统通过统一库存服务协调占用。",
      "mapping": "本地缓存变库存副本，目录变本地索引，全局目录变统一预约记录，桥转换两套接口。",
      "structural_changes": "把缓存一致性术语改为预约请求与确认；重新定义并缩短消息序列，不保留硬件专用回写语义。"
    },
    "checks": [
      "每个编号是否有唯一消息，返回路径是否闭合。",
      "桥带是否含混地覆盖了不属于转换层的部件。",
      "协议图例与左右域、全局域的颜色是否完全一致。"
    ],
    "editing": {
      "entry": "以 make_figure.py 为入口，example.json 提供编辑配置，labels.json 用于查文字键，asset.json 对应下列部件。",
      "configurable": "labels 改指定文字与字号；components 可显隐、平移和改属性；elements 修改单个矢量对象。平移保留固定几何，不会自动重新布线。",
      "code_required": "新增第三协议域、改变消息序列或移动桥接边界时必须重建引线及编号。 必须在 customize() 中处理新增矢量对象及连接，不能只扩大文字框。",
      "fonts": "当前字体映射使用 Tinos-Bold.ttf, Tinos-Regular.ttf；换标签后按最终插入宽度检查字宽、上下标和边界，不直接继承小字号。"
    },
    "display_code": "VA-083"
