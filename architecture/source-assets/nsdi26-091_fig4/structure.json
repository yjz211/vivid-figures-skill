      },
      {
        "id": "global-plan",
        "name": "全局计划区",
        "meaning": "切分器产生候选，预测器评价后影响切分。",
        "adaptation": "换成实际评价指标和规则，保留内部反馈方向。"
      },
      {
        "id": "local-left",
        "name": "实例一排程",
        "meaning": "显示分派到第一个实例的微任务顺序。",
        "adaptation": "用真实调度结果重排小条，不沿用现有字母次序。"
      },
      {
