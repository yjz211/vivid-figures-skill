    "adaptation": [
      "先决定请求颜色表示阶段而非任务身份",
      "将每个输入请求映射到切分计划和最终时间条，保证没有凭空新增片段",
      "修改状态交换标签，区分中间结果传递与普通任务分发",
      "扩大实例数时重画路由和外围回路，不仅复制容器"
    ],
    "example": {
      "scenario": "可用于假设的检验中心样本分批排程。",
      "mapping": "橙色为制样，蓝色为检测，全局计划切分批次，两台仪器对应局部实例。",
      "structural_changes": "把状态交换改成样本交接及记录同步；没有中途转移的检验项目删去跨实例双向箭头。"
    },
    "checks": [
      "同一请求的片段在输入、计划和时间条中是否对应",
      "两实例时间尺度和阶段颜色是否一致",
      "指标回传箭头是否回到使用该指标的预测环节"
    ],
    "editing": {
      "entry": "make_figure.py 读取 example.json 生成 fig.svg；加 --parts 导出部件，render_architecture.py 渲染预览及 PDF。",
      "configurable": "labels 按 labels.json 对象键改字；components 支持 visible、dx/dy、attributes；elements 改对象属性。位移用图内坐标，连线不自动重布。",
      "code_required": "增删模块、改连接和布局须修改 customize()。新对象须有唯一 data-asset-key 并登记部件归属；嵌套部件选一个层级平移，避免重复移动。",
      "fonts": "当前完整字体为 Arimo-Bold, Arimo-Regular。font_size 是元素局部坐标单位，受缩放变换影响，不是纸面字号；改长标签后按最终版面宽度复核换行与字距。"
    },
