  "guide": {
    "asset_id": "architecture.source.nsdi26-091_fig4",
    "title": "全局切分与局部执行反馈图",
    "summary": "以两段式请求为输入，展示全局切分、性能预测、分派和本地排程的完整闭环。上半部表达计划如何形成，下半部用时间条表达计划如何落到两个实例。请求字母和下标负责追踪身份，橙蓝两色区分处理阶段，因此不能把颜色随意改成机器编号。",
    "suitable_for": [
      "两阶段作业可切分并跨实例迁移的调度",
      "需要同时展示全局策略与本地执行顺序"
    ],
    "not_suitable_for": [
      "不可拆分的单阶段任务",
      "只有调度结果而无法说明切分或反馈来源"
    ],
    "reading_order": [
      "查看左上请求条的阶段组成",
      "按编号追踪切分器、计划和预测器之间的评估循环",
      "沿分派箭头进入下方两个局部调度器",
      "比较时间条与中间状态交换，再看右侧指标回传"
    ],
    "design": {
      "layout": "全局决策区置顶，两个执行实例并排在下方，右边单独留回传走廊。",
      "shapes": "天平、齿轮、剪刀分别提示切分权衡、预测和局部拆分；条块而非普通方框表示有顺序的微任务。",
      "connectors": "细箭头组织决策步骤，跨实例双向箭头表示状态交换，外围虚线路径标识性能反馈。",
      "color": "橙色与蓝色保持阶段语义，浅灰容器区分全局和局部作用范围；同一任务靠文字身份关联。",
      "typography": "短标签用无衬线字，容器标题加粗；微任务下标需在最终宽度可读，不用缩小整体字号解决拥挤。"
    },
    "parts": [
      {
        "id": "input-requests",
        "name": "阶段请求条",
        "meaning": "每行请求含两种阶段且长度可不同。",
