  "guide": {
    "asset_id": "architecture.source.asplos26-113_fig8",
    "title": "局部诊断驱动的结构迭代修复",
    "summary": "完整结构进入一个闭环：定位歧义区域、求局部解、枚举结构修改、检验候选、把选中修改写回。每一阶段都有小型结构示例，因此适合说明图结构怎样变化，而不是仅列出算法步骤名称。",
    "suitable_for": [
      "针对图、电路或路径结构逐步诊断并修复的算法",
      "需要显示候选修改为何被接受或拒绝的优化过程"
    ],
    "not_suitable_for": [
      "没有明确节点和边含义的普通迭代优化",
      "只想展示收敛曲线或实验性能"
    ],
    "reading_order": [
      "左侧读完整结构，确认节点、连边和重复线的含义。",
      "进入左中上部黄色区域，定位被提取的局部问题。",
      "向下读局部解，再向右看多个候选修改。",
      "向上查看筛选判据和保留结果，随后进入最右的应用修改。",
      "沿底部回箭头返回完整结构，理解循环而非一次性输出。"
    ],
    "design": {
      "layout": "窄整图列在左，两个中间列上下分格，右侧高面板展示应用结果；大外框和底部回线包住循环。",
      "shapes": "圆点、空心圈和线构成结构符号；黄色不规则底块圈出局部区域，候选中用彩色标记标注变化。",
      "connectors": "粗黑箭头说明阶段顺序；小型结构中的细线表示内部连接，蓝色小箭头用于修改标注，不能混读。",
      "color": "白灰保持结构中性，黄色定位局部问题，绿红标记接受与拒绝，蓝色突出候选动作；均需配文字或符号解释。",
      "typography": "阶段标题多为衬线小字，结构标注更小；密度很高，适合通栏或拆成分图。"
    },
