  "guide": {
    "title": "分解采集与按需重建架构",
    "summary": "左侧主机把观测对象拆成公共结构、可变参数和元信息，右侧后端先匹配结构，再按是否取得参数形成不同完整度的重建结果。用户查询入口位于右上，后端还可反向要求主机补报。细小图元贯穿两区，是说明数据怎样分解并重新组合的关键。",
    "suitable_for": [
      "结构复用与参数分离的采集系统",
      "按需补齐详细信息的观测架构"
    ],
    "not_suitable_for": [
      "所有数据必须完整实时上报的流程",
      "没有共同结构的独立对象仓库"
    ],
    "reading_order": [
      "从左侧应用与采集点向下进入解析代理",
      "区分公共模式库和参数缓冲的两类内容",
      "沿上报通道到后端匹配及拓扑重建",
      "检查条件合并、查询入口与反向补报通知"
    ],
    "design": {
      "layout": "左主机右后端，右上悬置查询入口，底部横排图例；主机叠框代表重复部署实例。",
      "shapes": "绿色扇形是公共结构、黄色曲片是参数、星形是元信息、粉色菱形是采集点；不是装饰。",
      "connectors": "红色通道上报模式及元信息，橙色关联选择性参数，蓝色反向通知补报；虚框标记条件路径。",
      "color": "浅灰托住主要模块，绿色和黄色绑定两类被拆分的数据；对象与其存储框采用一致色意。",
      "typography": "衬线粗体标题较紧凑，底部图例要保留到论文尺寸仍可辨，不能只保留彩图而省略释义。"
    },
    "adaptation": [
      "先确定结构复用前提，再决定模式与参数的拆分边界",
      "两种输出分别标注包含和缺少的信息",
      "保留条件分支语义，不能把采样合并画成每次必经",
      "增加对象类别时更新图例和所有匹配框，避免只改局部颜色"
    ],
    "example": {
      "scenario": "可用于工业设备诊断报告的按需汇集方案。",
      "mapping": "公共结构对应故障事件模板，参数对应传感器读数，元信息对应索引，后端先生成事件概要再按需补全细节。",
      "structural_changes": "用真实字段定义概要与完整报告，并把反向通知接到能补采数据的组件；无保留缓存时不能承诺补报历史参数。"
    },
    "checks": [
      "每种图元在左右区域是否保持同一含义",
      "完整输出是否确实依赖所需参数",
      "反向补报是否指向仍持有数据的组件"
    ],
    "asset_id": "architecture.source.asplos25-002_fig9",
    "parts": [
      {
        "id": "host-collector",
        "name": "端侧分解采集",
