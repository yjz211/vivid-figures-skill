  "guide": {
    "asset_id": "architecture.source.sosp24-035_fig1",
    "title": "前馈层稀疏激活与矩阵展开",
    "summary": "左侧自下向上的网络层栈通过虚线放大到右侧两行矩阵乘法。下行先做 FC1 与 ReLU，上行接收稀疏激活并做 FC2；绿色行列和红色选框把激活位置与保留权重联系起来。它是一个局部计算结构，不是完整训练网络。",
    "suitable_for": [
      "两层线性变换之间的筛选或稀疏门控",
      "将网络模块展开为具体矩阵运算的解释图"
    ],
    "not_suitable_for": [
      "完整深度学习训练流程",
      "没有行列对应关系的普通模块连接图"
    ],
    "reading_order": [
      "从左下 Self-Attention 向上读 FC1、ReLU、FC2。",
      "沿左下 FC1 放大线转到右下矩阵乘法。",
      "右下从权重乘输入得到结果，再经 ReLU 形成带红框的稀疏输出。",
      "沿弯曲虚线把下方结果接到右上的 FC2 输入。",
      "对照上方绿色权重列与输入红框的位置，最后读取 FC2 输出。"
    ],
    "design": {
      "layout": "窄左栏层栈与宽右栏双矩阵面板并置；右侧上为 FC2，下为 FC1，计算顺序与空间上下顺序相反。",
      "shapes": "圆角层框、二维格状权重、竖直向量与红色选择框分担不同语义；放大框用黑色虚线。",
      "connectors": "左栈箭头向上，右侧各矩阵算式向右；下方到上方的弧形虚线把 ReLU 结果传给 FC2。红虚线是位置对应，不是通信。",
      "color": "蓝色层框、浅黄注意力块、灰色未强调权重，绿色为参与计算的行列，红色框线标出对应稀疏位置。",
      "typography": "层名无衬线，矩阵标签较小且靠近底边，乘号与等号大于文字；图本身很小，需要放大后再用于论文。"
    },
    "parts": [
      {
        "id": "layer-stack",
        "name": "自下向上的模块栈",
        "meaning": "将注意力块与 MLP 的 FC1/ReLU/FC2 顺序明确出来。",
        "adaptation": "增加网络层时保持真实计算方向并重新定位放大连线。"
      },
      {
        "id": "fc2-product",
        "name": "第二层矩阵展开",
        "meaning": "以保留的输入位置选择 FC2 权重列并输出结果。",
        "adaptation": "根据新的稀疏索引同步更新绿色列、输入红框和对应虚线。"
      },
      {
        "id": "fc1-product",
        "name": "第一层与激活门控",
        "meaning": "FC1 的行选择经乘法和 ReLU 形成稀疏激活。",
        "adaptation": "改变向量维度时重建格数，保留乘法、激活与上行接口。"
      }
    ],
    "adaptation": [
      "先写清两次矩阵乘法的维度及门控定义，避免只照搬格子数。",
      "同步修改 FC1 高亮行、ReLU 保留位置与 FC2 高亮列。",
      "若只有一次线性变换，应删去另一行及回接弧线，不能继续称为两层模块。",
      "将来源的小尺寸构图放到足够宽的版心，检查红虚线、细网格及符号。"
    ],
    "example": {
      "scenario": "假设场景：两阶段特征筛选预测器。",
      "mapping": "FC1 为特征变换，ReLU 改为阈值筛选，FC2 为回归映射。",
      "structural_changes": "根据阈值输出重新标出保留索引并改写第二层的列选择；任何预测结果另由数据计算。"
    },
    "checks": [
      "左栈是否从底向上而非误写自上向下。",
      "FC1 输出与 FC2 输入维度和选中位置是否一致。",
      "红色对应线是否被误当数据流。",
      "微小标签是否在最终导出 PDF 中可读。"
    ],
    "editing": {
      "entry": "make_figure.py 为本图定制入口；example.json 配置一次生成；labels.json 定位文字；asset.json 保存部件及其元素成员。运行 python make_figure.py --config example.json --out . --parts。",
      "configurable": "labels、components 可修改文字、配色、显隐与位移；它们不会根据新标签长度自动重排，也不会重算图中示意数值。",
      "code_required": "拓扑、对象数量和跨部件连接在 customize(root, context) 中编辑。新增对象设 data-asset-key 并更新对应部件 element_keys；跨区域连线默认留在整图，移动部件后需重接；有重叠部件时避免重复位移同一元素。",
      "fonts": "层名无衬线，矩阵标签较小且靠近底边，乘号与等号大于文字；图本身很小，需要放大后再用于论文。 最终字体文件以构建映射为准；源坐标的局部 font_size 不等于论文纸面 pt，需按最终插图宽度复核。本批构建已确认并嵌入完整字体：texgyreheros-bold.otf, texgyreheros-regular.otf。映射可能改变原字形和字宽，需按实际论文尺寸复核。"
    },
