  "guide": {
    "asset_id": "architecture.source.osdi26-108_fig3",
    "title": "后台准备与停机重启的迁移对照",
    "summary": "在同一横向时间方向上比较两种迁移策略。上半部让保留节点继续工作、加入节点后台准备，到切换点才传输状态；下半部展示停止、重排和恢复。节点角色、迁移阶段和停机长度是三个不同编码维度。",
    "suitable_for": [
      "在线迁移与停止重启比较",
      "需要说明准备可与正常运行重叠的过程"
    ],
    "not_suitable_for": [
      "没有共同时间参照的方案对比",
      "用示意长度证明实测加速比"
    ],
    "reading_order": [
      "先读迁移前保留、离开和加入三类节点。",
      "沿上行进入后台准备，再进入切换阶段。",
      "关注状态传输和离开节点的退出标记。",
      "沿下行读停止与恢复路径，最后比较共同时间线。"
    ],
    "design": {
      "layout": "上、下两行对照共享从左到右的时间方向，中间用时间轴隔开。",
      "shapes": "小方块串联为节点计算链，虚线组框表示节点角色；红叉表示退出，圆弧虚线表示状态传输。",
      "connectors": "常规计算用黑箭头，迁移用红箭头，底部长条标出停止时段而非网络链路。",
      "color": "浅黄背景标准备，浅粉标切换或重启，绿线强调较短停机；颜色不能兼作吞吐量。",
      "typography": "阶段名用斜体，时间注释靠轴；保留节点等角色名反复出现但字号保持一致。"
    },
    "parts": [
      {
        "id": "before-migration",
        "name": "迁移前角色",
        "meaning": "区分继续工作、退出和加入的节点。",
        "adaptation": "填入实际角色，不把加入节点提前画成运行。"
      },
      {
        "id": "background-prepare",
        "name": "后台准备",
        "meaning": "正常工作持续时准备新节点上下文。",
        "adaptation": "标明可并行准备的状态，不能假设所有数据都提前就绪。"
      },
      {
        "id": "hot-switch",
        "name": "切换动作",
        "meaning": "传输必要状态并改变连接。",
        "adaptation": "更新红线起终点和退出叉号。"
      },
      {
        "id": "baseline-stop-restart",
        "name": "停机基线",
        "meaning": "停止后重排，再从检查点恢复。",
        "adaptation": "使用本次真实基线，不能人为添加额外阶段。"
      },
      {
        "id": "shared-timeline",
        "name": "共同时间参照",
        "meaning": "对照运行和不可用区间。",
        "adaptation": "如非按比例，必须明确示意。"
      }
    ],
    "adaptation": [
      "先确定切换点前后哪些节点仍可完成业务。",
      "时间条使用实测值才可解释为耗时差；否则只表示阶段顺序。",
      "删改节点时同时处理所有状态传输线和计算链。"
    ],
    "example": {
      "scenario": "假设用于在线交通预测服务扩容。",
      "mapping": "保留节点继续处理时间窗，新增节点装载模型状态，旧节点在窗口边界移交任务。",
      "structural_changes": "将训练参数改成预测状态；基线设为停止服务后重新装载，检查点图标改为模型快照。"
    },
    "checks": [
      "同一节点跨阶段身份与颜色一致。",
      "后台准备时没有把新节点画成已经接管。",
      "两方案停机区间采用相同起止定义。"
    ],
    "editing": {
      "entry": "以 make_figure.py 为入口，先复制 example.json 作为当前情景配置；labels.json 定位标签，asset.json 定位部件。",
      "configurable": "labels 可改文字和文字样式，components 可做显隐、平移和局部样式调整；elements 可定位矢量元素。配置只作用于已有几何，不会自动解决布局冲突。",
      "code_required": "节点数量、阶段长度与切换关系变化需同时修改多处重复图元；共享引擎不依据时间值自动重建时间轴。",
      "fonts": "当前替换字体为 Arimo-Bold、Arimo-Italic、Arimo-Regular。改字后检查字宽、基线及 PDF 字体嵌入；原图的逐字定位不保证能容纳更长名称。"
    },
    "display_code": "VA-066"
  },
