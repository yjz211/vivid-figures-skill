  "guide": {
    "asset_id": "architecture.source.osdi23-022_fig2",
    "title": "生成测试与等价执行的验证流水线",
    "summary": "上排从测试输入经双路跟踪到执行记录及依赖图，下排构造一条可比较的替代执行路径，并把两份结果汇合到判定处。去环与重跑形成局部反馈，展示验证器如何处理不能直接排序的依赖。可复用的是“构造可比执行、比较结果”的组织逻辑，而不是默认任何重排都保持语义等价。",
    "suitable_for": [
      "差分执行、变形测试或等价性验证流程",
      "含执行记录、依赖重建和局部修复循环的验证工具"
    ],
    "not_suitable_for": [
      "没有有效参照结果的单路测试",
      "把数值近似相同直接当成严格等价的说明"
    ],
    "reading_order": [
      "先读上排生成输入与两种观测跟踪。",
      "沿执行、记录、构图读取依赖图的由来。",
      "转到下排局部去环与重跑，识别循环的停止条件。",
      "追踪替代执行和原执行两路结果进入比较器，再读判定输出。"
    ],
    "design": {
      "layout": "横向长图在第三阶段折到下排，第四阶段占较大空间；局部循环位于下排左侧，比较出口位于最右。",
      "shapes": "圆柱表示状态存储，文档表示测试输入，表格表示记录，节点边表示依赖；图标之后仍附短语避免只靠形状猜义。",
      "connectors": "灰色大箭头串联宏观步骤，黑色细箭头表示局部数据依赖；红色高亮替代执行与结果比较路径。",
      "color": "主体以黑灰保持秩序，红色限定在待比较路径与差异提示，绿色只用于匹配结果，不代表性能优越。",
      "typography": "阶段标题加粗并编号；文档下的小标签应保留内容类型，不把完整规则塞入图标。"
    },
    "parts": [
      {
        "id": "case-input",
        "name": "测试输入集合",
        "meaning": "生成待执行用例及关联初始状态",
        "adaptation": "按真实输入格式替换文件图标，明确随机生成与既有样本的区别。"
      },
      {
        "id": "instrumentation",
        "name": "双路观测",
        "meaning": "针对不同状态或访问对象记录执行行为",
        "adaptation": "只有两种独立观测时保留双路；不要把两路误画成两次串行处理。"
      },
      {
        "id": "dependency-graph",
        "name": "执行与依赖构建",
        "meaning": "从运行记录建立操作间约束",
        "adaptation": "明确记录类型和构边规则，图结构必须来自实际依赖。"
      },
      {
        "id": "decycling",
        "name": "去环及重跑",
        "meaning": "遇到循环依赖时调整用例并重建图",
        "adaptation": "写清允许改变的内容和停止条件，不能默认为任意删边即可等价。"
      },
      {
        "id": "equivalent-validation",
        "name": "等价执行比较",
        "meaning": "按合法顺序运行替代用例并对照原结果",
        "adaptation": "先定义等价条件或容差，再显示一致或差异；差异还需诊断而非立即定性。"
      }
    ],
    "adaptation": [
      "先写明两路执行的可比前提、初始状态和判定口径。",
      "替换测试输入及观测内容，再按真实记录构建依赖图。",
      "确定修复循环是否合法，删除没有实际实现的重跑回边。",
      "将两份结果分别接入比较点，明确匹配与差异的含义及后续处理。"
    ],
    "example": {
      "scenario": "假设验证两个调度仿真实现是否保持事件语义。",
      "mapping": "测试用例为事件脚本，跟踪模块记录资源占用和时间依赖，依赖图提供合法事件重排，比较器核对最终状态和关键轨迹。",
      "structural_changes": "去环不能随意删除事件，应改为拒绝无效用例或修正生成器；若允许数值误差，出口改为满足容差与超出容差。"
    },
    "checks": [
      "两份结果是否来自相同初始状态与可比输入，比较前提是否明确？",
      "去环回路是否仅在允许范围内修改用例，而非删掉导致失败的约束？",
      "判定出口是否区分发现差异与已经确认缺陷？"
    ],
    "editing": {
      "entry": "在工作副本修改 example.json，运行 python make_figure.py --config example.json --out output --parts；再通过 Vivid 的矢量渲染入口检查 SVG 与 PDF。",
      "configurable": "labels 按 labels.json 的元素键改字；components 按本页部件 id 设置 visible、dx、dy 或 attributes；elements 修改指定矢量元素属性。重叠部件可能共享元素，避免对父区域和内部区域重复位移。",
      "code_required": "新增观测分支、变更重跑回路或比较条件需在 customize 中重画步骤连接；图不会执行测试或证明等价。这些接口不会自动重排，也不会随部件移动自动修复跨部件连线。",
      "fonts": "本资产已记录的完整字形资源：Arimo-Bold.ttf, Carlito-Bold.ttf, Carlito-Italic.ttf, Carlito-Regular.ttf。修改英文标签优先沿用对应字体族与字重；文字变长时调整框宽和换行，不靠整体缩小压入。其他语言须另选覆盖所需字符的字体并实查导出。"
    },
    "display_code": "VA-057"
  },
