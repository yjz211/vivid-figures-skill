  "guide": {
    "asset_id": "architecture.source.osdi26-063_fig5",
    "title": "从整体日程到局部权衡的四层展开",
    "summary": "四行依次呈现整体迭代、双批次重叠、单分区细日程以及时间—能耗权衡。跨行曲线把一个局部选择与宏观执行联系起来；底部小曲线是方案依据，不应被当作可直接继承的实验结果。",
    "suitable_for": [
      "分层解释并行调度与多目标方案选择",
      "既要看整体时序又要看局部重叠细节的方法"
    ],
    "not_suitable_for": [
      "没有真实时间关系的普通业务流程",
      "没有计算数据却打算保留前沿曲线作为结果"
    ],
    "reading_order": [
      "读顶部迭代块与被选中的局部时段。",
      "顺展开线进入两条批次的交错执行。",
      "继续到单分区日程，区分计算块与重叠通信。",
      "最后看两个时间—能耗前沿及高亮点如何对应选定日程。"
    ],
    "design": {
      "layout": "四条横向层级由虚线分隔，左栏说明层级，右侧承担时序和曲线；下两层比例不同。",
      "shapes": "时间矩形代表执行段，括号标重复块范围，小坐标系表达权衡；不同层的宽度不能直接跨层比较。",
      "connectors": "橙色曲线连接展开对象，黑线用于时序关系和注释；不要把展开线读成实际通信。",
      "color": "橙蓝区分两类分区并联系前沿高亮点；细日程还用绿色标通信，需有明确图例。",
      "typography": "左栏多行标签要短；算子缩写和坐标轴名承担技术信息，最终纸面需专门检查小字。"
    },
    "parts": [
      {
        "id": "iteration",
        "name": "整体迭代日程",
        "meaning": "两行前向后向任务及局部选择。",
        "adaptation": "改成真实宏观任务阶段；时间不按比例时标示意。"
      },
      {
        "id": "overlap",
        "name": "双批次重叠",
        "meaning": "两批次内计算和通信交错及重复块范围。",
        "adaptation": "按实际依赖重排，不能为紧凑而让有依赖的阶段重叠。"
      },
      {
        "id": "kernel-schedule",
        "name": "分区内部日程",
        "meaning": "更细的算子与通信并行关系。",
        "adaptation": "替换算子，标明资源分配、启动时刻及频率是否可决策。"
      },
      {
        "id": "tradeoff-frontiers",
        "name": "局部权衡前沿",
        "meaning": "两类分区的时间与能耗候选。",
        "adaptation": "以当前计算结果重绘曲线和高亮点；无结果则换为明确示意。"
      }
    ],
    "adaptation": [
      "建立宏观块到局部块的一一对应，再绘展开线。",
      "每一行独立注明时间尺度，不暗示所有横向距离同尺度。",
      "只保留实际采用的优化变量和通信重叠。",
      "前沿和选中点必须与最终日程参数对应，不能只改坐标名。"
    ],
    "example": {
      "scenario": "假设展示多机器生产的能耗调度。",
      "mapping": "顶层为生产批次，中层为加工与搬运重叠，细层为单工序设备动作，底层为工期—能耗候选。",
      "structural_changes": "重算工序依赖并改为真实加工时段；没有能耗实验时删除前沿数据，保留变量关系示意。"
    },
    "checks": [
      "每条展开线是否指向同一个局部块的下层解释。",
      "通信或搬运的重叠是否违背前置依赖。",
      "两个前沿高亮点是否能追溯到所示日程及相同单位。"
    ],
    "editing": {
      "entry": "运行 make_figure.py，以 example.json 为改造配置；labels.json 查文字键，--parts 同步导出部件。",
      "configurable": "labels 改文字，components 改显示、位移及样式，elements 改单个矢量属性；只选一个部件层级移动，避免重叠归属使对象移动两次。",
      "code_required": "这是可编辑矢量结构，未实现自动布局。增删模块、改变连接或重新排版，须在 customize() 中改真实对象并更新部件成员。",
      "fonts": "使用随包完整映射字体；改字后核查换行、符号和最终纸面字号。font_size 是对象局部单位，不能直接当作 PDF 的磅值。"
    },
    "display_code": "VA-100"
  },
