  "guide": {
    "asset_id": "architecture.source.asplos25-110_fig2",
    "title": "异构核心与共享矩阵单元的硬件分区图",
    "summary": "左侧两块不同细节的 SIMT 核心、中央共享存储和右侧矩阵单元组成紧凑硬件平面图。三个颜色的连线把主存、共享存储与 DMA 传输分开，虚线边界标出可选硬件。",
    "suitable_for": [
      "需要说明通用核心与独立专用加速器如何共享存储",
      "同一硬件图中必须区分三类通信和可选模块"
    ],
    "not_suitable_for": [
      "只有抽象软件模块、无需说明存储连接的系统",
      "把形状面积当真实芯片面积的定量布局"
    ],
    "reading_order": [
      "从左上 SIMT 核心读执行、寄存器、访存和缓存结构。",
      "对照左下简化核心与其可选 Tensor Core。",
      "读中央互连、共享存储银行及右侧 DMA、同步器。",
      "最后读右下矩阵单元，并以右上图例跟踪三类通信。"
    ],
    "design": {
      "layout": "左侧上下两个核心区，中央窄共享存储列，右侧上主存下矩阵单元；图例利用右上空白。",
      "shapes": "矩形模块为主，Tensor Core 和矩阵单元用虚线外框，存储银行与阵列处理单元用规则重复格。",
      "connectors": "蓝线主存、黄线共享存储、红线 DMA，部分为双向；弧线绕开模块，局部黑线为内部连接。",
      "color": "缓存青蓝、Tensor Core 绿、共享存储黄、DMA 珊瑚红、矩阵区粉色；颜色与路径图例需要分开解释。",
      "typography": "无衬线文字多级，区域标题稍大，缓存和寄存器标签多行；小模块字高是缩印瓶颈。"
    },
    "parts": [
      {
        "id": "detailed-core",
        "name": "详细通用核心",
        "meaning": "左上核心展开流水线、缓存、寄存器与可选矩阵部件。",
        "adaptation": "可改造成完整工作节点详图，删改模块需同步内部总线。"
      },
      {
        "id": "compact-core",
        "name": "简化通用核心",
        "meaning": "左下核心以 Lane 列表表达相同核心类别的另一种展开。",
        "adaptation": "维护与上方的术语一致，不能误称两个互斥配置为同时部署事实。"
      },
      {
        "id": "shared-bank",
        "name": "互连与分银行共享存储",
        "meaning": "中央互连服务四个存储银行并连接两类计算资源。",
        "adaptation": "银行数变化时重排黄色格并重接互连线。"
      },
      {
        "id": "memory-hierarchy",
        "name": "外存与二级缓存",
        "meaning": "右上 DRAM 与 L2 缓存连接主存流。",
        "adaptation": "改存储层级时维护蓝色通信的统一含义。"
      },
      {
        "id": "dma-sync",
        "name": "传输与同步模块",
        "meaning": "DMA 与同步器位于核心和矩阵单元之间。",
        "adaptation": "按实现改为传输引擎或屏障控制器；不要凭位置补造未画的边。"
      },
      {
        "id": "matrix-unit",
        "name": "共享矩阵加速单元",
        "meaning": "累加存储、Scratchpad、脉动阵列和控制 FSM 被虚线框包围。",
        "adaptation": "替换为真实专用加速器组件，阵列增减须调整容器。"
      },
      {
        "id": "traffic-legend",
        "name": "三类传输图例",
        "meaning": "蓝黄红箭头分别命名主存、共享存储与 DMA 流量。",
        "adaptation": "任何路径改色都同步更新该图例。"
      }
    ],
    "adaptation": [
      "先将通用核心、共享资源和专用计算单元对应到实际系统，再考虑保留哪些细节。",
      "保持三种流量颜色，逐条核对真实起终点；不新增未经证据支持的同步线。",
      "可选组件使用虚线框，并在正文说明可选条件。",
      "增加银行、Lane 或阵列格需要 customize 重排，固定配置只支持既有对象修改。"
    ],
    "example": {
      "scenario": "假设示例：边缘视觉节点的通用处理器与共享推理加速器",
      "mapping": "左侧对应两个处理核心，中央为共享工作缓冲，右下为卷积/矩阵加速模块。",
      "structural_changes": "按设备实际缓存层级与 DMA 接口重建路径，删去不存在的 Tensor Core 和同步器。"
    },
    "checks": [
      "三类通信线的颜色是否与图例一致。",
      "虚线框是否准确表示可选组件。",
      "共享存储银行数量与标号是否连续。",
      "弧线是否压住模块名称或穿过不相关模块。",
      "面积和位置是否被误解释为物理芯片布局。"
    ],
    "editing": {
      "entry": "make_figure.py 调用本包共享运行库；example.json 配置本图实例，labels.json 定位可编辑文字，asset.json 登记语义部件。运行 python make_figure.py --config example.json --out . --parts 生成整图及部件。",
      "configurable": "labels、components 支持既有文字、配色、显隐和位移；修改配置不会自动重排布局或重接跨部件箭头。",
      "code_required": "改变对象数量或拓扑时在 customize(root, context) 中编辑矢量；新元素设置 data-asset-key 并登记到部件 element_keys。重叠语义区域不可同时移动同一元素。",
      "fonts": "图面为 Helvetica 风格无衬线，多行小标签与可选模块标题需独立校验。最终字体文件以构建映射为准；局部 font_size 使用源坐标，不能直接视为纸面 pt。本批构建已确认并嵌入完整字体：texgyreheros-regular.otf。映射可能改变原字形和字宽，需按实际论文尺寸复核。"
    },
    "display_code": "VA-113"
  },
  "changes": []
