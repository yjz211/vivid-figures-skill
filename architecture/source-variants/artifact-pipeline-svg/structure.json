  "guide": {
    "asset_id": "architecture.artifact-pipeline",
    "title": "逐阶段推导与中间产物列",
    "summary": "用输入、处理阶段、产物三列讲清方案如何形成。中列顺序推进，右列把每步抽象操作落实成图、曲线、分配表或时间表，末步回到左下执行端。它适合强调推导过程的总览，示意小图本身不构成计算证据。",
    "suitable_for": [
      "多步规划与调度方法",
      "每步都有可解释中间表示的算法"
    ],
    "not_suitable_for": [
      "并行分支占主导的流程",
      "只有最终结果、没有阶段产物的方法"
    ],
    "reading_order": [
      "从左栏输入确认问题对象与资源条件。",
      "沿中栏自上而下阅读阶段依赖。",
      "逐行向右核对该阶段实际生成什么。",
      "由末阶段沿左向箭头进入执行端。"
    ],
    "design": {
      "layout": "三栏固定横向位置，行高随阶段数累加；输入可对齐不同阶段。",
      "shapes": "浅绿步骤卡叠浅灰阴影；产物用虚线小框容纳具体图元。",
      "connectors": "中列短竖箭头表示依赖，横箭头表示产出；输入折线必须接到真正消费该输入的阶段。",
      "color": "主体用低饱和灰绿，产物内部颜色区分任务或资源，暖红斜体标出产物名称。",
      "typography": "栏标题与阶段名加粗，长阶段名可分两行；产物标题短于一整句。"
    },
